# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local build output (see `npm run build:android:local`)
*.apk

# git worktrees (each is its own working tree with its own node_modules)
.claude/worktrees/

# Claude Code: personal/local-machine overrides only -- never shared or
# committed (permissions, paths, etc. specific to one machine). This is
# distinct from .claude/settings.json and .claude/skills/, which ARE
# intentionally tracked project config (shared team settings, the
# ui-ux-design skill used throughout this project) and must stay tracked.
.claude/settings.local.json

# AI-assistant-generated planning/spec docs from past sessions -- kept
# locally for reference, not published to the remote (mentions another
# machine's local path).
docs/superpowers/

# Supabase CLI's own local cache dir (created by `npx supabase ...`)
supabase/.temp/
